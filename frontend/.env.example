# Copy this file to frontend/.env (Vite only reads .env, never .env.example).
#
# Where the frontend sends its API + Socket.IO traffic. Leave this line
# commented out to talk to a backend running on your own machine
# (http://localhost:5000/api).
#
# To run the frontend locally against the backend hosted on Render, uncomment
# and set it to your Render URL, keeping the trailing /api and NO trailing slash:
#
# VITE_API_BASE_URL=https://your-app-name.onrender.com/api
#
# Restart `npm run dev` after changing this - Vite only reads it at startup.
