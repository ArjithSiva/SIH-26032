PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/procurement_queue
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Dev-mode toggles: keep true while there is no real telecom provider.
# Flip to false only when a real SMS/WhatsApp/IVR provider has been wired in.
SIMULATE_OTP=true
SIMULATE_NOTIFICATIONS=true

# Starting password given to any centre that doesn't have one yet (new
# centres created via seed/scrape, or old ones auto-backfilled at startup -
# see utils/ensureCentreDefaults.js). Each centre's password can be changed
# individually afterwards from the admin panel or that centre's own
# settings tab - this is only the initial value.
DEFAULT_OFFICER_PASSWORD=centre123

# Optional: enables real translation (IVR prompts, site-wide UI strings)
# and real voice audio (Bhashini TTS) instead of the built-in EN/TA/HI/TE
# prompt text and the browser's own speechSynthesis voice.
#
# Mapping from the Bhashini "Udyat" onboarding dashboard (Your API Keys tab)
# to these two variables:
#   BHASHINI_USER_ID  = the long ID shown under your app's name (the
#                        "kalanjiyam" card) - e.g. 18630665a27e4c...
#   BHASHINI_API_KEY  = the "UDYAT KEY" value
# The "INFERENCE" key shown on that same dashboard is NOT needed here - the
# app fetches the equivalent value itself at runtime via the Pipeline
# Config call, using these two (see utils/bhashiniClient.js).
#
# NOTE: on an SIH/hackathon-tier Udyat key, both a CEO approval AND a
# separate Manager approval are required before the key actually works for
# real calls - check your dashboard's "Key Request Details" for both
# statuses. If Manager's Approval still shows "Pending", translate/TTS
# calls will keep failing (falling back to English / browser voice)
# regardless of how correctly these two values are set - that's expected,
# not a bug. Run `node scripts/testBhashini.js` (from the project root,
# after `cd backend && npm install`) to see the raw response and confirm
# whether it's an approval issue or something else.
#
# Leave both unset to keep the app fully working without them (see
# utils/bhashiniClient.js and the frontend's utils/speech.js for the
# fallback behaviour).
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Only needed if you're using a non-default Bhashini pipeline.
BHASHINI_PIPELINE_ID=
